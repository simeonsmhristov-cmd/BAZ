/**
 * Попълва Google Form въпросника за уебсайта на БАЗ.
 * Работи с формата, към която е отворен скриптът (Extensions -> Apps Script),
 * или с формата по ID по-долу.
 */
const FORM_ID = '1mV4xb55nRuR-47k47juCiJnuc_PzUVlQQpc9MKSObzo';

function buildForm() {
  const form = FormApp.openById(FORM_ID);

  // Изчистване на съществуващи въпроси, за да няма дублиране при повторно пускане
  form.getItems().forEach(function (item) { form.deleteItem(item); });

  form.setTitle('Въпросник за новия уебсайт на Българската асоциация за заетостта (БАЗ)');
  form.setDescription(
    'Здравейте,\n\n' +
    'За да изградим модерен, функционален и визуално разпознаваем уебсайт на Българската асоциация за заетостта, ' +
    'бих искал да уточним няколко важни детайла.\n\n' +
    'Ще използвам предоставения прототип като отправна точка за съдържанието и структурата на сайта. ' +
    'Въпросите по-долу ще ми помогнат да определя правилната визуална концепция и да съобразя дизайна с вашите цели и аудитория.\n\n' +
    'Не е необходимо отговорите да бъдат дълги или формални. Дори кратки насоки и няколко примера ще бъдат полезни ' +
    'за изграждането на правилната визуална концепция.'
  );

  function section(title) {
    form.addPageBreakItem().setTitle(title);
  }
  function para(title, help) {
    form.addParagraphTextItem().setTitle(title).setHelpText(help || '');
  }

  // 1. За организацията и нейната идентичност
  // (първата секция няма нужда от page break – започва директно)
  form.addSectionHeaderItem().setTitle('1. За организацията и нейната идентичност');
  para('1. Как бихте описали БАЗ с 3–5 думи?',
       'Например: надеждна, модерна, достъпна, професионална, иновативна, прозрачна.');
  para('2. Какво е най-важното впечатление, което искате посетителите да получат от сайта?',
       'Например: доверие и сигурност, професионализъм, достъпност, авторитет или модерно мислене.');
  para('3. С какво БАЗ се отличава от други организации и платформи, свързани със заетостта?',
       'Кое е най-силното ви предимство, което трябва да подчертаем?');

  // 2. Целева аудитория и цели на сайта
  section('2. Целева аудитория и цели на сайта');
  form.addCheckboxItem()
    .setTitle('4. Кои са основните посетители на сайта и коя аудитория е с най-висок приоритет?')
    .setHelpText('Може да изберете няколко. Ако искате да посочите приоритет, добавете го в „Други“.')
    .setChoiceValues([
      'Хора, които търсят работа',
      'Работодатели, които искат да станат членове',
      'Настоящи членове на асоциацията',
      'Институции и партньорски организации'
    ])
    .showOtherOption(true);
  para('5. Кое е най-важното действие, което посетителят трябва да предприеме?',
       'Например: да разгледа обяви за работа, да кандидатства за членство, да се запознае с организацията или да изпрати запитване.');
  para('6. Как бихте определили успеха на новия уебсайт?',
       'Например: повече кандидати за работа, повече нови членове, по-голяма разпознаваемост на БАЗ или изграждане на доверие.');

  // 3. Визуален стил и дизайн
  section('3. Визуален стил и дизайн');
  para('7. Имате ли съществуваща визуална идентичност, която трябва да следваме?',
       'Лого, фирмени цветове, шрифтове, брандбук или други материали.');
  form.addCheckboxItem()
    .setTitle('8. Какъв визуален стил предпочитате за сайта?')
    .setHelpText('Може да посочите и комбинация от няколко стила.')
    .setChoiceValues([
      'Изчистен, минималистичен и модерен',
      'Корпоративен, сериозен и институционален',
      'Динамичен, съвременен и технологичен',
      'Приветлив, човешки и достъпен'
    ])
    .showOtherOption(true);
  para('9. Има ли уебсайтове, чийто дизайн харесвате?',
       'Моля, споделете 2–3 примера с линкове и, ако е възможно, какво точно ви допада в тях – цветове, типография, подредба, снимки, анимации или цялостно усещане.');
  para('10. Има ли визуални решения, които категорично не бихте искали да присъстват?',
       'Например: прекалено много цветове, тежък корпоративен стил, прекомерни анимации, стандартни стокови снимки и др.');

  // 4. Съдържание и начална страница
  section('4. Съдържание и начална страница');
  para('11. Считате ли структурата и текстовете в предоставения прототип за окончателни?',
       'Има ли секции, които можем да пренаредим, съкратим, обединим или представим по различен начин с цел по-добро потребителско изживяване?');
  para('12. Кои са трите най-важни неща, които посетителят трябва да разбере още от началната страница?');
  para('13. Разполагате ли с качествени снимки или други визуални материали?',
       'Например: снимки на екипа, работодатели, работна среда, партньори или проведени събития. Предпочитате ли да използваме реални снимки, професионални стокови изображения или илюстрации?');

  // 5. Функционалност и бъдещо развитие
  section('5. Функционалност и бъдещо развитие');
  para('14. Кои функционалности са задължителни още при първоначалното стартиране на сайта?',
       'Например: обяви за работа, търсене и филтриране, форми за кандидатстване, членска директория, контактни форми и др.');
  para('15. Предвиждате ли развитие на сайта с допълнителни функционалности или секции?',
       'Например: лични профили, управление на обяви, новини, събития, ресурси за работодатели или кандидати.');

  // 6. Допълнителни насоки
  section('6. Допълнителни насоки');
  para('16. Има ли нещо друго, което смятате за важно да знам, преди да започна работа по дизайна?',
       'Това може да включва специфични изисквания, бъдещи планове, ограничения или идеи, които искате да обсъдим.');

  Logger.log('Готово: ' + form.getEditUrl());
}
